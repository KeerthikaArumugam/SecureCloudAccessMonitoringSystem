# ──────────────────────────────────────────────────────────────────────────────
# SecureCloud Access Monitoring System — Environment Variables Template
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control — it is already listed in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# Flask secret key — generate a new one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# ── Database ──────────────────────────────────────────────────────────────────
# Absolute or relative path to the SQLite database file.
DATABASE_PATH=database.db

# ── Session Security ──────────────────────────────────────────────────────────
# Set to "true" in production (requires HTTPS).
SESSION_COOKIE_SECURE=false

# ── Password Reset — SMTP Mail Settings ──────────────────────────────────────
#
# DEVELOPMENT MODE (default when MAIL_SERVER is empty):
#   Leave MAIL_SERVER blank.  The reset URL is stored in memory and printed to
#   the Flask console.  No real email is sent.  Safe for local development.
#
# PRODUCTION MODE — Gmail SMTP (recommended for most users):
#   Step 1: Enable 2-Step Verification on your Google Account.
#           https://myaccount.google.com/security
#   Step 2: Generate a Gmail App Password (NOT your normal Gmail password).
#           https://myaccount.google.com/apppasswords
#           Select app: "Mail"  |  Select device: "Other (custom name)"
#           Copy the 16-character password shown.
#   Step 3: Fill in the variables below using that App Password.
#
# PRODUCTION MODE — Office 365 / Outlook SMTP:
#   MAIL_SERVER=smtp.office365.com
#   MAIL_PORT=587
#   MAIL_USE_TLS=true
#   MAIL_USERNAME=your-address@outlook.com
#   MAIL_PASSWORD=your-account-password
#   MAIL_DEFAULT_SENDER=your-address@outlook.com
#
# PRODUCTION MODE — Other provider:
#   Consult your provider's SMTP documentation and adjust accordingly.

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_DEFAULT_SENDER=your-gmail-address@gmail.com

# ── API Rate Limiting ─────────────────────────────────────────────────────────
API_RATE_LIMIT_PER_MINUTE=100
